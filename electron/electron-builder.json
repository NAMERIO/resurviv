{
  "appId": "biz.resurviv.desktop",
  "productName": "Resurviv",
  "npmRebuild": false,
  "publish": [
    {
      "provider": "github",
      "owner": "NAMERIO",
      "repo": "resurviv",
      "releaseType": "release"
    }
  ],
  "directories": {
    "output": "release"
  },
  "files": ["dist/**/*", "node_modules/**/*"],
  "extraResources": [{ "from": "assets", "to": "assets" }],
  "win": {
    "target": "nsis",
    "icon": "assets/tree-01.png",
    "artifactName": "Resurviv-Windows.${ext}"
  },
  "mac": {
    "target": ["dmg", "zip"],
    "icon": "assets/tree-01.png",
    "artifactName": "Resurviv-macOS.${ext}"
  },
  "linux": {
    "target": "AppImage",
    "icon": "assets/tree-01.png",
    "artifactName": "Resurviv-Linux.${ext}"
  }
}
